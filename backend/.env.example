# ==============================================================================
# CodeClash Backend Environment Configuration
# ==============================================================================
# Copy this file to `backend/.env` for local development.
# Never commit your production `.env` file to version control.

# JWT Authentication Secret
SECRET_KEY=codeclash-production-secure-jwt-key-2026-super-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# If MongoDB is unavailable, CodeClash automatically falls back to persistent local JSON files in data_store/
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=codeclash_db

# AI Explanation Engine (Optional)
# Leave blank to use server-side built-in rule analyzer, or provide a Google Gemini API key
GEMINI_API_KEY=
